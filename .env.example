# XXII Century Trucking - server environment
# Copy to .env and fill in. NEVER commit the real .env.

# --- Core (already in use today) ---
DATABASE_URL=postgres://user:password@host:5432/dbname
SESSION_SECRET=change-me

# Public base URL, used for certificate + driver portal links inside emails.
APP_URL=https://goxxii.com

# --- Driver emails (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Point at a verified goxxii.com sender once the domain is verified in Resend.
RESEND_FROM_EMAIL=XXII Century <noreply@ava.rankmehigher.com>

# --- Team notifications (Telegram) ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Optional - defaults to the existing ops group.
TELEGRAM_CHAT_ID=-1003752172558

# --- Fleet data (Samsara) --------------------------------------------------
# Read-only API token. WITHOUT it the rewards engine still runs, it just cannot
# award the MPG / safety / mileage rules. See docs/REWARDS-AUTOMATION.md.
SAMSARA_API_TOKEN=
# Only for EU-hosted Samsara accounts.
# SAMSARA_BASE_URL=https://api.eu.samsara.com

# --- Rewards automation ----------------------------------------------------
# Set to "off" to disable the built-in daily timer and use your own cron instead.
# Built-in daily award timer. OFF unless set to exactly "on".
# Turn it on only AFTER the seed run (see docs/REWARDS-HANDOVER.md).
REWARDS_AUTORUN=
# Lets an external scheduler call POST /api/rewards/run with an x-cron-secret
# header instead of a portal login. Generate with: openssl rand -hex 32
REWARDS_CRON_SECRET=
